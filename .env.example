# Canonical list of environment variables for the Vertex Compliance web app.
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser. Keep every other value server only.

# --- Clerk (authentication) ---
# Publishable key is client safe. The secret key stays on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Sanity (content) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-13
# Read token for the private dataset. Server only.
SANITY_API_READ_TOKEN=your_sanity_read_token

# --- PostHog (product analytics) ---
# The project key is public by design and reaches the browser.
# Host is the EU cloud ingestion endpoint for this project.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
